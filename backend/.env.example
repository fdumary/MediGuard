GROQ_API_KEY=your_groq_key_here
NLM_API_KEY=your_nlm_key_here

# Nutrient DWS API (sponsor: API Cloud AI Hackathon 2026)
# Handles ALL document generation for MediGuard: the SepsisGuard signed
# audit PDF and the CrossCare drug interaction report PDF, plus prescription
# PDF data extraction. Two separate products, two separate keys.
NUTRIENT_PROCESSOR_API_KEY=your_processor_key_here
NUTRIENT_EXTRACTION_API_KEY=your_extraction_key_here
NUTRIENT_BASE_URL=https://api.nutrient.io

# Doctavian API (sponsor: API Cloud AI Hackathon 2026)
# Generates a structured signed document of the CrossCare drug interaction
# report. Endpoint path in tools/doctavian_tool.py is unverified pending
# real docs from Doctavian — see that file's header for details.
DOCTAVIAN_BASE_URL=https://demo.api.doctavian.com
DOCTAVIAN_API_KEY=your_doctavian_key_here
